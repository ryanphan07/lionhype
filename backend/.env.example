# Copy to backend/.env and adjust. Every value shown is the default.

# LLM (OpenAI-compatible server, e.g. llama-server with --mmproj)
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=local-key
LLM_MODEL=qwen-coder
LLM_ENABLED=true
LLM_TIMEOUT=30.0
LLM_MAX_RETRIES=2

# Text to speech (edge-tts needs internet)
TTS_PROVIDER=edge_tts
TTS_VOICE=en-US-AnaNeural
TTS_ENABLED=true
TTS_TIMEOUT=10.0
TTS_MAX_RETRIES=2

# Server
LOG_LEVEL=INFO
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Base URL used to build audio_url links returned to the client
PUBLIC_BASE_URL=http://localhost:8000
# Root folder for videos/ and audio/ (default: backend/uploads)
# UPLOAD_DIR=C:/path/to/uploads

# Limits and cleanup
MAX_VIDEO_SECONDS=90
JOB_TTL_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=600
